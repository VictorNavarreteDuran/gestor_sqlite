{
  "name": "base-sqlite-pime",
  "version": "1.0.0",
  "description": "Plataforma web 100% local en navegador (WebAssembly) para gestionar archivos SQLite (.db) sin almacenar datos en el servidor",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build": "node scripts/build.js",
    "dev:cf": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "express": "^4.21.2",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "wrangler": "^4.168.0"
  }
}
